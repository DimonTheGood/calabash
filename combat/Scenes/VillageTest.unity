--- !u!114 &1745460317
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1745460316}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a443db6ab48f0f033afb3efbd322fa11, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Calabash.Game.GameFlow
  intro:
  - image: {fileID: 2800000, guid: 590445e388592bc29ac59724c746564d, type: 3}
    text: "\u0417\u0438\u043C\u0430. \u0413\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u0433\u043E\u0434.\n\u0423 \u043F\u0435\u043A\u0430\u0440\u044F \u0413\u0430\u0432\u0440\u0438\u043B\u044B \u043F\u0440\u043E\u043F\u0430\u043B \u043A\u0430\u0440\u0430\u0432\u0430\u0439."
  - image: {fileID: 2800000, guid: 058d508c2058c5febb1fe8998bb22c70, type: 3}
    text: "\u041A\u0430\u0440\u0430\u0432\u0430\u0439 \u0443\u043A\u0440\u0430\u043B \u0416\u0434\u0430\u043D.\n\u0415\u0433\u043E \u043F\u043E\u0439\u043C\u0430\u043B\u0438 \u0443 \u0440\u0435\u043A\u0438 \u0441 \u0445\u043B\u0435\u0431\u043E\u043C \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u043E\u0439."
  - image: {fileID: 2800000, guid: 129db82586a7dac4f95380739235b44c, type: 3}
    text: "\u041F\u043E\u043F \u041D\u0438\u043A\u043E\u0434\u0438\u043C \u0441\u043A\u0430\u0437\u0430\u043B: \u0432\u043E\u0440 \u0438 \u0431\u0435\u0441\u043E\u0432\u043E \u043E\u0442\u0440\u043E\u0434\u044C\u0435.\n\u041D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u0432\u0441\u0435 \u043A\u0438\u0432\u0430\u043B\u0438."
  - image: {fileID: 2800000, guid: d86c9a845c40f00f9b69f18720b56a78, type: 3}
    text: "\u0426\u0430\u0440\u044C \u0434\u0430\u0436\u0435 \u043D\u0435 \u043F\u043E\u0434\u043D\u044F\u043B \u0433\u043B\u0430\u0437.\n\xAB\u0421\u0436\u0435\u0447\u044C\xBB."
  - image: {fileID: 2800000, guid: 5d87d318b1d6c990f8a90bd807ebb783, type: 3}
    text: "\u041F\u0430\u043B\u0430\u0447 \u041A\u043E\u0440\u043D\u0435\u0439 \u0441\u043B\u043E\u0436\u0438\u043B \u0445\u0432\u043E\u0440\u043E\u0441\u0442\n\u0438 \u043F\u043E\u0434\u043D\u0451\u0441 \u0444\u0430\u043A\u0435\u043B."
  - image: {fileID: 2800000, guid: 844b3e1e3e94c9ae2ae71740ffa08f21, type: 3}
    text: "\u0416\u0434\u0430\u043D \u0441\u0433\u043E\u0440\u0435\u043B. \u041D\u043E \u043E\u0433\u043E\u043D\u044C \u043D\u0435 \u0443\u0448\u0451\u043B \u0438\u0437 \u043D\u0435\u0433\u043E.\n\n\u0422\u0435\u043F\u0435\u0440\u044C \u0433\u043E\u0440\u0438\u0442 \u0434\u0435\u0440\u0435\u0432\u043D\u044F."
